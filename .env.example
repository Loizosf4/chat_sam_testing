# Local configuration.
# Do not commit real local model paths in .env.
SAM_CHECKPOINT=<path-to-sam1-checkpoint>
SAM_MODEL_TYPE=vit_b
SAM_DEVICE=cpu

# Backward-compatible alias accepted by the app:
# SAM_CHECKPOINT_PATH=

# Local MoGe 2 configuration.
# Keep real machine-specific paths in your untracked .env or process environment.
MOGE_PYTHON=<path-to-moge-venv-python.exe>
MOGE_REPOSITORY=<path-to-local-moge-repository>
MOGE_CHECKPOINT=<path-to-moge-2-vitl-normal-model.pt>
MOGE_VERSION=v2
MOGE_DEVICE=cuda
MOGE_MODEL=moge-2-vitl-normal
# Set true only when you intentionally want slow CPU execution.
MOGE_ALLOW_CPU=false

# Future managed reconstruction-job compiler. This environment is separate from
# MOGE_PYTHON and must provide numpy, Pillow, scipy, pydantic, and jsonschema.
# The application backend does not consume this setting yet.
RECONSTRUCTION_PYTHON=<path-to-reconstruction-venv-python.exe>
